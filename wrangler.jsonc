{
  // Line Room deploys as a Worker serving the static site/ directory, behind
  // the Empire session gate. The Worker checks for a signed session cookie
  // before serving anything; without one it bounces to empirehq.win to log in.
  "name": "line-room",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // run_worker_first matters: without it Cloudflare serves matching static
  // files before the Worker runs, and the gate never executes — the JSON
  // under site/data/ would be readable by anyone.
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Slips, bets and settings. Odds and splits do NOT live here — they arrive
  // as JSON in site/data/ from the GitHub Actions collectors.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "line-room",
      "database_id": "83704a3a-fc35-45e0-8655-b5f52d4229fd"
    }
  ],

  // Who may delete other people's bets and manage the skip list. Must match
  // the name used in `passphrase.js add "<name>"`.
  "vars": {
    "OWNER": "Jake"
  },

  // Served from a subdomain, not the apex: empirehq.win is the hub, and
  // Line Room is one tenant on it. workers.dev stays disabled so there is
  // no second hostname bypassing the gate.
  "workers_dev": false,
  "routes": [
    { "pattern": "lines.empirehq.win", "custom_domain": true }
  ]

  // Secrets (set with `wrangler secret put`, never committed):
  //   AUTH_SECRET  cookie signing key — must match empire-hub exactly
  //
  // Passphrases are managed by ../empire-hub/tools/passphrase.js
}
