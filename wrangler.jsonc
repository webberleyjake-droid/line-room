{
  // Line Room deploys as a Worker serving the static site/ directory.
  // Cloudflare's dashboard can infer this, but keeping it here makes the
  // deploy explicit and reviewable, and is where D1/KV bindings go when
  // the slips + bet-log features move off the Claude artifact runtime.
  "name": "line-room",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site"
  },

  // Served from a subdomain, not the apex: empirehq.win is the hub, and
  // Line Room is one tenant on it. workers.dev stays disabled so there is
  // no second hostname bypassing Access.
  "workers_dev": false,
  "routes": [
    { "pattern": "lines.empirehq.win", "custom_domain": true }
  ]
}
